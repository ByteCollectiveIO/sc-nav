# Copy to .env and fill in for local `docker compose up`.
# In the Portainer git-stack deployment these are set in the stack's
# environment-variables UI instead — no .env file on the server.
# .env is gitignored; never commit real values.

# Discord OAuth app (Developer Portal -> your app -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Discord server (guild) the org lives in; members of this guild may log in.
ORG_GUILD_ID=
# Optional: restrict login to holders of this role id (blank = any guild member).
ORG_MEMBER_ROLE_ID=
# Comma-separated Discord user ids granted the ADMIN panel.
ADMIN_IDS=

# Session cookie signing key — generate with: openssl rand -hex 32
SESSION_SECRET=
# HTTPS-only session cookies. Leave blank or set true/1/yes/on for production;
# only set false/0/no/off for plain-HTTP local dev. Anything unrecognized is
# treated as true — this must never fail open.
COOKIE_SECURE=true

# Public base URL of the app, e.g. https://nav.example.com
SC_NAV_PUBLIC_URL=

# Cloudflare Tunnel connector token (Zero Trust dashboard) — used by the
# cloudflared sidecar in docker-compose.yml. Omit if you expose the app another way.
CLOUDFLARE_TUNNEL_TOKEN=

# OPTIONAL — Strata (CELD) mining API key, for Prospector's RS signature chart.
# Leave blank and the feature is simply absent: the FIELD-tab RS card falls back
# to the bases your own members derive from single-ore scans. Nothing else in the
# app depends on it.
# Get one free at https://strata.celd.space/api-keys (Discord login + verified
# email + your real name on file). With it set, the server re-syncs the feed at
# startup, at most once a day — Strata asks for per-patch caching, not polling,
# and asks that you credit them where the data is shown (the card does).
# You can also sync by hand from a clone: python3 tools/sync_strata.py
STRATA_API_KEY=

# OPTIONAL — upstream repo the admin update check compares against, "owner/name".
# Defaults to ByteCollectiveIO/sc-nav. Point it at your own fork to be told about
# your releases instead, or set it blank to switch the check off (no outbound call
# to GitHub at all). Read-only: the app never updates itself. Leave this line
# commented out to keep the default — setting it BLANK turns the check off.
#SC_NAV_UPDATE_REPO=
